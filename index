    <style>
        body {
            font-family: 'Hind Siliguri', 'Noto Sans Bengali', sans-serif;
            background-color: transparent;
            color: #0f172a;
        }

        /* Animated Shimmer Title with Graphical Font Accents */
        .shimmer-text {
            background: linear-gradient(90deg, #0284c7 0%, #38bdf8 50%, #0369a1 100%);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            animation: shine 4s linear infinite;
            letter-spacing: 0.5px;
        }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        /* Micro Upward Air-Blow Electrical Particle Animation */
        .vector-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
            opacity: 0.45;
        }

        .floating-icon {
            position: absolute;
            color: #0284c7;
            animation: airBlow 12s infinite linear;
            filter: drop-shadow(0 0 2px rgba(56, 189, 248, 0.4));
        }

        @keyframes airBlow {
            0% { transform: translateY(105vh) rotate(0deg) scale(0.8); opacity: 0; }
            15% { opacity: 0.8; }
            85% { opacity: 0.8; }
            100% { transform: translateY(-10vh) rotate(360deg) scale(1.2); opacity: 0; }
        }

        /* Screen Preview Settings for Print Sheet */
        #printable-pdf-container {
            display: none;
        }

        /* Minimal Single-Page A4 Printable PDF Engine Styles */
        @media print {
            @page {
                size: A4 portrait;
                margin: 4mm 6mm;
            }

            body * {
                visibility: hidden !important;
            }

            .vector-bg, header, form, footer, .no-print {
                display: none !important;
            }

            #printable-pdf-container, #printable-pdf-container * {
                visibility: visible !important;
            }

            #printable-pdf-container {
                display: block !important;
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                color: #0f172a !important;
                background: #ffffff !important;
                font-family: 'Hind Siliguri', 'Noto Sans Bengali', sans-serif !important;
            }

            #printable-pdf-container h2 {
                font-size: 20px !important;
                font-weight: 1000 !important;
                color: #0284c7 !important;
                margin: 0 !important;
                line-height: 1.1;
            }

            #printable-pdf-container p {
                font-size: 16px !important;
                color: #475569 !important;
                margin: 1px 0 0 0 !important;
            }

            #printable-pdf-container h3 {
                font-size: 16.5px !important;
                font-weight: 700 !important;
                color: #0f172a !important;
                margin: 2px 0 !important;
            }

            .pdf-meta-table {
                width: 100% !important;
                margin-bottom: 5px !important;
                border-collapse: collapse !important;
                font-size: 16px !important;
                color: #1e293b !important;
                font-weight: 900 !important;
            }

            .pdf-meta-table td {
                border: none !important;
                padding: 3px 0 !important;
            }

            /* Clean Minimal Table Styling */
            .pdf-minimal-table {
                width: 100% !important;
                border-collapse: collapse !important;
                table-layout: fixed !important;
            }

            .pdf-minimal-table th {
                border-bottom: 1.5px solid #0284c7 !important;
                padding: 2px 3px !important;
                font-size: 15px !important;
                text-align: left !important;
                color: #0369a1 !important;
                background-color: #f0f9ff !important;
                font-weight: 700 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .pdf-minimal-table td {
                border-bottom: 1px solid #e2e8f0 !important;
                padding: 1.2px 1px !important;
                vertical-align: middle !important;
                word-wrap: break-word !important;
            }

            .question-text-cell {
                font-size: 16px !important;
                font-weight: 600 !important;
                line-height: 1.15 !important;
                padding-right: 3.5px !important;
            }

            .pdf-category-row {
                background-color: #e0f2fe !important;
                color: #0369a1 !important;
                font-weight: 900 !important;
                font-size: 16px !important;
                line-height: 1.12 !important;
                padding: 3px 4px !important;
                letter-spacing: 0.3px !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .comment-cell {
                display: block !important;
                word-break: break-word !important;
                white-space: pre-wrap !important;
                line-height: 1.12 !important;
            }

            .checkbox-symbol {
                font-size: 15px !important;
                font-weight: bold !important;
                padding-left: 1px !important;
            }

            /* Signature Section - Left & Right */
            .signature-container {
                margin-top: 16px !important;
                display: flex !important;
                justify-content: space-between !important;
                align-items: flex-end !important;
                font-size: 16px !important;
                font-weight: 700 !important;
                color: #1e293b !important;
                padding: 0 10px !important;
            }

            .signature-box {
                text-align: center !important;
                width: 160px !important;
            }

            .signature-space {
                height: 36px !important;
            }

            .signature-line {
                border-top: 1px dotted #475569 !important;
                padding-top: 3px !important;
            }
        }
    </style>
</head>
