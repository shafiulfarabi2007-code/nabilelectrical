    <script>
        // Project Dropdown Toggle & Selection Logic
        function toggleProjectDropdown(show) {
            const dropdown = document.getElementById('projectDropdown');
            if (show) {
                dropdown.classList.remove('hidden');
            } else {
                setTimeout(() => dropdown.classList.add('hidden'), 200);
            }
        }

        function selectProject(projectName) {
            document.getElementById('projectName').value = projectName;
            document.getElementById('projectDropdown').classList.add('hidden');
        }

        // Hide dropdown when clicking outside
        window.addEventListener('click', function(e) {
            const projectInput = document.getElementById('projectName');
            const dropdown = document.getElementById('projectDropdown');
            if (projectInput && dropdown && !projectInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });

        // 21 Questions Configuration Matrix
        const questionsData = [
            { id: 1, text: "সাব-স্টেশনের ডিভাইজ গুলোতে কোন সমস্যা আছে কিনা", category: "সাব-স্টেশন", issueOn: "Y" },
