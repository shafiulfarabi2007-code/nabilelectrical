    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        skyAccent: '#0284c7',
                        skyLight: '#e0f2fe',
                        headerBlue: '#dbeafe',
                        borderBlue: '#93c5fd'
                    },
                    fontFamily: {
                        bangla: ['Hind Siliguri', 'Noto Sans Bengali', 'sans-serif']
                    }
                }
            }
        }
