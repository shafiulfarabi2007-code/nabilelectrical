            { id: 4, text: "প্যানেল বোর্ড পরিস্কার পরিছন্ন আছে কিনা", category: null, issueOn: "N" },
            { id: 5, text: "টেম্পারেচার ঠিক আছে কিনা", category: "কম্প্রেসর মেশিন", issueOn: "N" },
            { id: 6, text: "কম্প্রেসর মেশিনের মটর অতিরিক্ত গরম হয়েছে কিনা", category: null, issueOn: "Y" },
            { id: 7, text: "মটরের এম্পিয়ার ঠিক আছে কিনা", category: null, issueOn: "N" },
            { id: 8, text: "এয়ার ড্রায়ার চলছে কিনা", category: null, issueOn: "N" },
            { id: 9, text: "লাইন ফিল্টার গুলো ঠিক মত কাজ করছে কিনা", category: null, issueOn: "N" },
            { id: 10, text: "সকল মটর রানিং আছে কিনা", category: "মিল/ফ্যাক্টরী", issueOn: "N" },
            { id: 11, text: "কোন মটর অতিরিক্ত গরম হয়েছে কিনা", category: null, issueOn: "Y" },
            { id: 12, text: "মটরের এম্পিয়ার ঠিক আছে কিনা", category: null, issueOn: "N" },
            { id: 13, text: "মটর কানেকশনের ইলেক্ট্রিক্যাল ক্যাবল এর তাপমাত্রা ঠিক আছে কিনা", category: null, issueOn: "N" },
            { id: 14, text: "মটর টার্মিনালে কোন লুজ কানেকশন আছে কিনা", category: null, issueOn: "Y" },
            { id: 15, text: "স্পেয়ার পার্টসের কারণে কোন মেশিন বন্ধ আছে কিনা", category: null, issueOn: "Y" },
            { id: 16, text: "প্লান্টের সব গুলো এসি ঠিক আছে কিনা", category: null, issueOn: "N" },
            { id: 17, text: "জেনারেটরের জন্য পর্যাপ্ত তেল মজুত আছে কিনা", category: "জেনারেটর", issueOn: "N" },
            { id: 18, text: "জেনারেটর রানিং আছে কিনা", category: null, issueOn: "N" },
            { id: 19, text: "ইলেক্ট্রিক্যাল ফল্ট ব্রেক ডাউন আছে কিনা", category: "ইলেক্ট্রিক্যাল ফল্ট ব্রেক ডাউন", issueOn: "Y", isBoth19: true },
            { id: 20, text: "লোড শেডিং ছিলো কিনা", category: null, issueOn: "Y", isBoth20: true },
            { id: 21, text: "অন্যান্য কোন সমস্যা থাকলে লিখুন (ঐচ্ছিক)", category: null, isOther: true }
        ];

        // Format Date as DD/MM/YY
        function getFormattedDate() {
            const today = new Date();
            const dd = String(today.getDate()).padStart(2, '0');
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const yy = String(today.getFullYear()).slice(-2);
            return `${dd}/${mm}/${yy}`;
        }

        // Render Web UI Items
        function renderForm() {
            document.getElementById('checkDate').value = getFormattedDate();
            const container = document.getElementById('questionsContainer');
            container.innerHTML = '';

            questionsData.forEach(q => {
                let html = '';

                if (q.category) {
                    html += `
                        <div class="bg-sky-100/90 text-sky-900 font-bold px-4 py-2 rounded-xl border border-sky-200 mt-4 text-base shadow-sm backdrop-blur-sm">
                            <i class="fa-solid fa-folder-open text-sky-600 mr-2"></i> ${q.category}
                        </div>
                    `;
                }

                if (q.isOther) {
                    html += `
                        <div class="bg-slate-50/90 p-4 rounded-xl border border-sky-100 shadow-sm space-y-2">
                            <label class="block font-semibold text-slate-800 text-sm">২১. ${q.text}</label>
                            <textarea id="q21_reason" rows="2" placeholder="অন্যান্য বিবরণ লিখুন..." class="w-full p-2.5 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-white"></textarea>
                        </div>
                    `;
                } else if (q.isBoth19) {
                    // Question 19 Specific Dual Option Input (Hour + Minute + Comment)
                    html += `
                        <div class="bg-white/95 p-4 rounded-xl border border-sky-100 shadow-sm hover:border-sky-300 transition-all space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <span class="font-semibold text-slate-800 text-sm sm:w-2/3">১৯. ${q.text}</span>
                                <div class="flex items-center gap-6">
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_19" value="Y" onchange="toggleReason(19)" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        হ্যাঁ
                                    </label>
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_19" value="N" onchange="toggleReason(19)" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        না
                                    </label>
                                </div>
                            </div>

                            <div id="reason_box_19" class="hidden pt-2 grid grid-cols-1 md:grid-cols-4 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-sky-800 mb-1">কত ঘন্টা:</label>
                                    <input type="number" id="input_19_hour" min="0" placeholder="ঘন্টা" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-sky-800 mb-1">কত মিনিট:</label>
                                    <input type="number" id="input_19_min" min="0" max="59" placeholder="মিনিট" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-sky-800 mb-1">ব্রেক ডাউন সংক্রান্ত বিবরণ / মন্তব্য:</label>
                                    <input type="text" id="input_19_reason" placeholder="কারণ ও বিবরণ প্রদান করুন" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                                </div>
                            </div>
                        </div>
                    `;
                } else if (q.isBoth20) {
                    // Question 20 Specific Dual Option Input (Hour + Minute)
                    html += `
                        <div class="bg-white/95 p-4 rounded-xl border border-sky-100 shadow-sm hover:border-sky-300 transition-all space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <span class="font-semibold text-slate-800 text-sm sm:w-2/3">২০. ${q.text}</span>
                                <div class="flex items-center gap-6">
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_20" value="Y" onchange="toggleReason(20)" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        হ্যাঁ
                                    </label>
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_20" value="N" onchange="toggleReason(20)" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        না
                                    </label>
                                </div>
                            </div>

                            <div id="reason_box_20" class="hidden pt-2 grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-sky-800 mb-1">কত ঘন্টা লোড-শেডিং ছিলো:</label>
                                    <input type="number" id="input_20_hour" min="0" placeholder="ঘন্টা" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-sky-800 mb-1">কত মিনিট লোড-শেডিং ছিলো:</label>
                                    <input type="number" id="input_20_min" min="0" max="59" placeholder="মিনিট" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div class="bg-white/95 p-4 rounded-xl border border-sky-100 shadow-sm hover:border-sky-300 transition-all space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <span class="font-semibold text-slate-800 text-sm sm:w-2/3">${q.id}. ${q.text}</span>
                                <div class="flex items-center gap-6">
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_${q.id}" value="Y" onchange="toggleReason(${q.id})" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        হ্যাঁ
                                    </label>
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-sm">
                                        <input type="radio" name="q_${q.id}" value="N" onchange="toggleReason(${q.id})" class="w-4 h-4 text-sky-600 focus:ring-sky-500">
                                        না
                                    </label>
                                </div>
                            </div>

                            <div id="reason_box_${q.id}" class="hidden pt-2">
                                <label class="block text-xs font-semibold text-sky-800 mb-1">কারণ লিখুন:</label>
                                <input type="text" id="input_${q.id}" placeholder="কারণ প্রদান করুন" class="w-full px-3 py-2 border border-sky-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500 bg-sky-50/50">
                            </div>
                        </div>
                    `;
                }

                container.innerHTML += html;
            });
        }

        // Handle Trigger Reasoning Fields
        function toggleReason(qId) {
            const q = questionsData.find(item => item.id === qId);
            if (!q || q.isOther) return;

            const selectedOption = document.querySelector(`input[name="q_${qId}"]:checked`);
            const reasonBox = document.getElementById(`reason_box_${qId}`);

            if (selectedOption && selectedOption.value === q.issueOn) {
                reasonBox.classList.remove('hidden');
            } else {
                reasonBox.classList.add('hidden');
                if (q.isBoth19) {
                    document.getElementById('input_19_hour').value = '';
                    document.getElementById('input_19_min').value = '';
                    document.getElementById('input_19_reason').value = '';
                } else if (q.isBoth20) {
                    document.getElementById('input_20_hour').value = '';
                    document.getElementById('input_20_min').value = '';
                } else {
                    document.getElementById(`input_${qId}`).value = '';
                }
            }
        }

        // Adjust Font Sizes Dynamically inside the PDF Comment Cells
        function adjustPdfFontSizes() {
            const cells = document.querySelectorAll('.comment-cell');
            cells.forEach(cell => {
                const textLength = cell.innerText.trim().length;
                if (textLength > 150) {
                    cell.style.fontSize = '7.2px';
                } else if (textLength > 80) {
                    cell.style.fontSize = '8.2px';
                } else {
                    cell.style.fontSize = '12px';
                }
            });
        }

        // Prepare Printable View and Direct Download / Print
        function prepareAndPrint() {
            const projName = document.getElementById('projectName').value.trim();
            const checklister = document.getElementById('checklisterName').value.trim();

            if (!projName || !checklister) {
                alert("অনুগ্রহ করে প্রজেক্টের নাম এবং চেকলিস্টার নাম প্রদান করুন।");
                return;
            }

            // Fill Header Meta Values
            document.getElementById('pdfProjectName').innerText = projName;
            document.getElementById('pdfChecklister').innerText = checklister;
            document.getElementById('pdfShift').innerText = document.getElementById('shiftChoice').value === 'A' ? 'A (8am-8pm)' : 'B (8pm-8am)';
            document.getElementById('pdfDate').innerText = document.getElementById('checkDate').value;

            // Fill Minimal Print Table
            const tbody = document.getElementById('pdfTableBody');
            tbody.innerHTML = '';

            questionsData.forEach(q => {
                if (q.category) {
                    const catRow = `
                        <tr class="pdf-category-row">
                            <td colspan="4">${q.category}</td>
                        </tr>
                    `;
                    tbody.innerHTML += catRow;
                }

                if (q.isOther) {
                    const otherVal = document.getElementById('q21_reason').value.trim();
                    const row = `
                        <tr>
                            <td class="question-text-cell">২১. ${q.text}</td>
                            <td style="text-align: center;">-</td>
                            <td style="text-align: center;">-</td>
                            <td><span class="comment-cell">${otherVal || ''}</span></td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                } else if (q.isBoth19) {
                    const selected = document.querySelector('input[name="q_19"]:checked');
                    const val = selected ? selected.value : '';
                    const hVal = document.getElementById('input_19_hour').value.trim();
                    const mVal = document.getElementById('input_19_min').value.trim();
                    const rVal = document.getElementById('input_19_reason').value.trim();

                    const yesBox = val === 'Y' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';
                    const noBox = val === 'N' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';

                    let combinedText = '';
                    if (hVal || mVal) {
                        combinedText += `ব্রেক ডাউন: `;
                        if (hVal) combinedText += `${hVal} ঘন্টা `;
                        if (mVal) combinedText += `${mVal} মিনিট`;
                        combinedText += `। `;
                    }
                    if (rVal) combinedText += rVal;

                    const row = `
                        <tr>
                            <td class="question-text-cell">১৯. ${q.text}</td>
                            <td style="text-align: center;">${yesBox}</td>
                            <td style="text-align: center;">${noBox}</td>
                            <td><span class="comment-cell">${combinedText}</span></td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                } else if (q.isBoth20) {
                    const selected = document.querySelector('input[name="q_20"]:checked');
                    const val = selected ? selected.value : '';
                    const hVal = document.getElementById('input_20_hour').value.trim();
                    const mVal = document.getElementById('input_20_min').value.trim();

                    const yesBox = val === 'Y' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';
                    const noBox = val === 'N' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';

                    let combinedText = '';
                    if (hVal || mVal) {
                        combinedText += `লোড-শেডিং: `;
                        if (hVal) combinedText += `${hVal} ঘন্টা `;
                        if (mVal) combinedText += `${mVal} মিনিট`;
                    }

                    const row = `
                        <tr>
                            <td class="question-text-cell">২০. ${q.text}</td>
                            <td style="text-align: center;">${yesBox}</td>
                            <td style="text-align: center;">${noBox}</td>
                            <td><span class="comment-cell">${combinedText}</span></td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                } else {
                    const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
                    const val = selected ? selected.value : '';
                    const reasonVal = document.getElementById(`input_${q.id}`) ? document.getElementById(`input_${q.id}`).value.trim() : '';

                    const yesBox = val === 'Y' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';
                    const noBox = val === 'N' ? '<span class="checkbox-symbol">☑</span>' : '<span class="checkbox-symbol">☐</span>';

                    const row = `
                        <tr>
                            <td class="question-text-cell">${q.id}. ${q.text}</td>
                            <td style="text-align: center;">${yesBox}</td>
                            <td style="text-align: center;">${noBox}</td>
                            <td><span class="comment-cell">${reasonVal}</span></td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                }
            });

            // Adjust Font Size for Comment Fields dynamically based on text length
            adjustPdfFontSizes();

            // Trigger Direct Browser Print & Save
            window.print();
        }

        // Share via WhatsApp
        function shareWhatsApp() {
            const proj = document.getElementById('projectName').value.trim() || 'Electrical Checklist';
            const text = encodeURIComponent(`Nabil Electrical Checklist for Project: ${proj}. Check details.`);
            window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
        }

        // Share via Email
        function shareEmail() {
            const proj = document.getElementById('projectName').value.trim() || 'Electrical Checklist';
            const subject = encodeURIComponent(`Nabil Electrical Checklist - ${proj}`);
            const body = encodeURIComponent(`Hello,\n\nPlease find the electrical maintenance checklist details for ${proj}.\n\nDate: ${getFormattedDate()}`);
            window.location.href = `mailto:?subject=${subject}&body=${body}`;
        }

        // Init Engine
        window.onload = renderForm;
    </script>
</body>
</html>
